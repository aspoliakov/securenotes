TEAM_ID=
BUNDLE_ID=com.aspoliakov.securenotes
APP_NAME=securenotes

// version.properties is plain `key = value`, so it's a valid xcconfig: provides $(major), $(minor), $(patch)
#include "../../../tools/versioning/version.properties"

MARKETING_VERSION = $(major).$(minor).$(patch)
CURRENT_PROJECT_VERSION = $(major).$(minor).$(patch)

// Google Sign-In redirect URL scheme: REVERSED_CLIENT_ID from GoogleService-Info.plist
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1038246125981-h87333olcd3k58gks1cqm50kosubdmcm
